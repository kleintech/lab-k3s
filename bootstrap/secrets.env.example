# Copy to ~/.config/lab-k3s/secrets.env (chmod 600). Never commit the real file.
# Cloudflare API token with Zone:DNS:Edit + Zone:Zone:Read on kleincogroup.com
# (same token as ~/.config/cloudflare/api-token; 10-secrets.sh falls back to that file).
CLOUDFLARE_API_TOKEN=
# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# GitHub token for Actions Runner Controller. Fine-grained PAT on the repos that will use
# the runners: Administration RW, Metadata R  (or classic PAT with `repo`).
GITHUB_RUNNER_TOKEN=
